{
  "name": "praxis",
  "version": "0.1.0",
  "description": "The browser & desktop polyglot IDE — Python first, plus 29+ languages.",
  "author": "Hossam Magdy Balaha <h3ossam@gmail.com> (https://hossambalaha.github.io/)",
  "desktopName": "com.praxis.desktop",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "packageManager": "bun@1.3.14",
  "main": "electron-main.js",
  "scripts": {
    "desktop:build": "bun run build && bun scripts/dereference-standalone.js && bunx electron-builder",
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && bun scripts/copy-standalone.mjs",
    "build:compiler": "PRAXIS_REACT_COMPILER=1 next build && bun scripts/copy-standalone.mjs",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "desktop": "bun scripts/desktop.mjs",
    "desktop:native": "bun scripts/desktop.mjs --native",
    "lint": "bun scripts/lint-with-budget.mjs",
    "lint:raw": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "bun run test:unit",
    "check:examples": "tsx scripts/check-examples.ts",
    "check": "bun run lint && bun run typecheck && bun run test:unit",
    "db:push": "echo '[praxis] no prisma database in this app'",
    "db:generate": "echo '[praxis] no prisma database in this app'"
  },
  "build": {
    "appId": "com.praxis.desktop",
    "productName": "Praxis",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/android-chrome-512x512.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/android-chrome-512x512.png",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}-Portable.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}-Portable.${ext}",
      "icon": "public/android-chrome-512x512.png"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}-Setup.${ext}"
    },
    "files": [
      "electron-main.js",
      ".next/standalone/**/*"
    ],
    "npmRebuild": false,
    "asar": false
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.2",
    "geist": "^1.9.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.525.0",
    "mermaid": "^12.3.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "5.1.1",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.4",
    "electrobun": "^2.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
